{
  "name": "iron-and-dust",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "dev": "vite --host",
    "build": "tsc --noEmit && vite build",
    "build:single": "tsc --noEmit && vite build --mode single",
    "preview": "vite preview --host",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "sprites": "tsx tools/sprites.ts"
  },
  "dependencies": {
    "@fontsource/jersey-10": "5.3.0",
    "@fontsource/vt323": "5.3.0",
    "phaser": "3.90.0"
  },
  "devDependencies": {
    "@types/pngjs": "6.0.5",
    "playwright-core": "1.64.1",
    "pngjs": "7.0.0",
    "tsx": "4.20.6",
    "typescript": "5.9.3",
    "vite": "8.3.4",
    "vite-plugin-singlefile": "2.3.3",
    "vitest": "5.0.5"
  }
}
